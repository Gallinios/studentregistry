@model List<Student>
@{
    ViewData["Title"] = "Μαθητές";
    var search = ViewData["Search"] as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">Μαθητές</h1>
    <a class="btn btn-primary" asp-action="Create">+ Νέος μαθητής</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Κλείσιμο"></button>
    </div>
}

<form asp-action="Index" method="get" class="d-flex gap-2 mb-3" role="search">
    <input type="search" name="search" value="@search" class="form-control" placeholder="Αναζήτηση με όνομα ή email" aria-label="Αναζήτηση" />
    <button type="submit" class="btn btn-outline-secondary">Αναζήτηση</button>
    @if (!string.IsNullOrWhiteSpace(search))
    {
        <a asp-action="Index" class="btn btn-link">Καθαρισμός</a>
    }
</form>

@if (Model.Count == 0)
{
    <p class="text-muted">Δεν βρέθηκαν μαθητές.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Ονοματεπώνυμο</th>
                    <th>Ηλικία</th>
                    <th>Email</th>
                    <th class="text-end">Ενέργειες</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.Id</td>
                        <td>@s.Name</td>
                        <td>@s.Age</td>
                        <td>@s.Email</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@s.Id">Επεξεργασία</a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@s.Id">Διαγραφή</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small">Σύνολο: @Model.Count</p>
}
